From b7bbcc59f416d4c81d2133fd104e3b40c16742f2 Mon Sep 17 00:00:00 2001
From: Peppersawce <michaelpeppers89@yahoo.it>
Date: Tue, 14 Apr 2026 22:46:41 +0200
Subject: Change OpenSb asset font to avoid a crash


diff --git a/assets/opensb/interface.config.patch b/assets/opensb/interface.config.patch
index 03ebffd..b0260c2 100644
--- a/assets/opensb/interface.config.patch
+++ b/assets/opensb/interface.config.patch
@@ -33,7 +33,7 @@
 
   "tooltip" : { "previewArmorWith" : "player" },
   "debugTextStyle" : {
-    "font" : "iosevka-semibold",
+    "font" : "NotoSans-SemiBold",
     "fontSize" : 7,
     "backDirectives" : "border=1;fff;fff7?multiply=333a"
   },
diff --git a/assets/opensb/interface/optionsmenu/optionsmenu.config.patch b/assets/opensb/interface/optionsmenu/optionsmenu.config.patch
index 4755b45..d68c176 100644
--- a/assets/opensb/interface/optionsmenu/optionsmenu.config.patch
+++ b/assets/opensb/interface/optionsmenu/optionsmenu.config.patch
@@ -20,7 +20,7 @@
       "type" : "button",
       "disabled" : true,
       "position" : [133, 185],
-      "caption" : "^#a0a000,font=iosevka-semiboldoblique;TODO^#aa7;:^reset; Players",
+      "caption" : "^#a0a000,font=NotoSans-SemiBold;TODO^#aa7;:^reset; Players",
       "base" : "/interface/optionsmenu/duocontrolsbutton.png",
       "hover" : "/interface/optionsmenu/duocontrolsbuttonhover.png"
     },
diff --git a/assets/opensb/scripts/opensb/universeclient/voicemanager.lua b/assets/opensb/scripts/opensb/universeclient/voicemanager.lua
index 9e1f81e..e82fc7d 100644
--- a/assets/opensb/scripts/opensb/universeclient/voicemanager.lua
+++ b/assets/opensb/scripts/opensb/universeclient/voicemanager.lua
@@ -83,7 +83,7 @@ local function drawSpeakerBar(mouse, pos, speaker, i)
 		if input.keyHeld("LShift") then
 			textPositioning.position = {pos[1] + 288, pos[2] + 24}
 			textPositioning.horizontalAnchor = "right"
-			canvas:drawText("^#fff7,font=iosevka-semibold;" .. tostring(speaker.speakerId), textPositioning, 16, nil, nil, nil, FONT_DIRECTIVES)
+			canvas:drawText("^#fff7,font=NotoSans-SemiBold;" .. tostring(speaker.speakerId), textPositioning, 16, nil, nil, nil, FONT_DIRECTIVES)
 		end
 
 		if input.mouseDown("MouseLeft") then
-- 
2.52.0


From c7fa95c3395b637cd46d11ad6d6ccae2db960321 Mon Sep 17 00:00:00 2001
From: Peppersawce <michaelpeppers89@yahoo.it>
Date: Tue, 14 Apr 2026 23:13:07 +0200
Subject: Adapt Linux startup script for Hpkg


diff --git a/scripts/linux/sbinit.config b/scripts/linux/sbinit.config
index 66776ed..ae69373 100644
--- a/scripts/linux/sbinit.config
+++ b/scripts/linux/sbinit.config
@@ -1,10 +1,12 @@
 {
   "assetDirectories" : [
-    "../assets/",
-    "./mods/"
+    "/boot/home/config/settings/OpenStarbound/assets/",
+    "/boot/home/config/data/OpenStarbound/assets/",
+    "/boot/system/data/OpenStarbound/assets/",
+    "/boot/home/config/settings/OpenStarbound/mods/"
   ],
 
-  "storageDirectory" : "./",
+  "storageDirectory" : "/boot/home/config/settings/OpenStarbound/storage/",
 
   "assetsSettings" : {
     "pathIgnore" : [],
-- 
2.52.0
